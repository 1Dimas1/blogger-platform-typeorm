# Copy to src/env/.env.<NODE_ENV>.local and fill in real values.
# On Vercel all of these are set as project environment variables.

PORT=3000
NODE_ENV=development

# Either DATABASE_URL (Neon) or the DB_* group
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=blogger_typeorm_dev
# TypeORM synchronize; keep false and use migrations (yarn migration:run)
DB_AUTOSYNC=false
# run pending migrations on app start (true on Vercel)
DB_MIGRATIONS_RUN=false

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE_IN=5m
REFRESH_TOKEN_EXPIRE_IN=20m
EMAIL_CONFIRMATION_CODE_EXPIRE_IN=
PASSWORD_RECOVERY_CODE_EXPIRE_IN=

ADMIN_LOGIN=
ADMIN_PASSWORD=

GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URL=
OAUTH_TOKEN_TTL_MS=
OAUTH_REFRESH_BUFFER_MS=
FRONTEND_URL=
EMAIL_CONFIRMATION_PATH=
PASSWORD_RECOVERY_PATH=

IS_SWAGGER_ENABLED=true
IS_SWAGGER_STATIC_DOWNLOAD_NEEDED=false
INCLUDE_TESTING_MODULE=true
SEND_INTERNAL_SERVER_ERROR_DETAILS=false
IS_PRODUCTION_DOMAIN_ERROR_RESPONSE_FORMAT=true
IS_USER_AUTOMATICALLY_CONFIRMED=false

# IP restriction (auth endpoints): set RATE_LIMIT_MAX_REQUESTS very high to effectively disable it
RATE_LIMIT_TTL_MS=10000
RATE_LIMIT_MAX_REQUESTS=5

COOKIE_HTTP_ONLY=true
COOKIE_SECURE=true
COOKIE_PATH=/
COOKIE_DOMAIN=
COOKIE_MAX_AGE_MS=
COOKIE_SAME_SITE=none
